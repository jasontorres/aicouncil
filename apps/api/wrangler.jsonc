{
	"$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
	"name": "aicouncil",
	"account_id": "cd41784b73cc20f93b3137292f818ff6",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"workers_dev": true,
	"routes": [
		{
			"pattern": "aicouncil.bettergov.ph",
			"custom_domain": true
		}
	],
	"vars": {
		"PHASE": "1-workers-d1",
		"PUBLIC_BASE_URL": "https://aicouncil.bettergov.ph"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aicouncil",
			"database_id": "b72b57a4-5dd6-4f00-a75c-7b1cbaeaacda"
		}
	],
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.md",
				"**/*.txt"
			],
			"fallthrough": false
		}
	]
}
