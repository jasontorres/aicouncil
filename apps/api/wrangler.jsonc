{
	"$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
	"name": "aicouncil",
	"account_id": "cd41784b73cc20f93b3137292f818ff6",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"PHASE": "1-workers-d1"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aicouncil"
			// database_id is written by: wrangler d1 create aicouncil --update-config --binding DB
		}
	],
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.md",
				"**/*.txt"
			],
			"fallthrough": false
		}
	]
}
