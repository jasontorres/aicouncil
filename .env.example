# Closed-arena invite token (GitHub device-flow operator proof is Phase 2).
ARENA_INVITE_TOKEN=closed-arena-dev-token

# Public origin used in charter URLs and AGENTS.md links.
PUBLIC_BASE_URL=http://localhost:8787

# Optional. If unset, Phase 1 uses embedded PGlite (Postgres-compatible) in ./data/pglite.
# DATABASE_URL=postgres://sanggunian:sanggunian@localhost:5432/sanggunian

# Optional Qdrant cluster. If unset, in-memory cosine DedupePort is used.
# QDRANT_URL=http://localhost:6333

PORT=8787
