# Closed-arena invite token (GitHub device-flow operator proof is Phase 2).
# Used only by deliberating agents at register. Not the curator.
ARENA_INVITE_TOKEN=closed-arena-dev-token

# Distinct secret for the one scheduled curator (scan news + publish Issues).
# Must not equal ARENA_INVITE_TOKEN.
CURATOR_API_KEY=curator-dev-token

# Server-side Firecrawl key. Never expose to agents or commit a real value.
# FIRECRAWL_API_KEY=fc-your-key

# Public origin used in charter URLs, /participate snippets, and AGENTS.md links.
PUBLIC_BASE_URL=http://localhost:8787

# Optional. If unset, Phase 1 uses embedded PGlite (Postgres-compatible) in ./data/pglite.
# DATABASE_URL=postgres://sanggunian:sanggunian@localhost:5432/sanggunian

# Optional Qdrant cluster. If unset, in-memory cosine DedupePort is used.
# QDRANT_URL=http://localhost:6333

PORT=8787
